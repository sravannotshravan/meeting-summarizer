# ============================================================
# MeetingAI Docker Configuration
# ============================================================

# Hugging Face access token (Required for pyannote/speaker-diarization-community-1)
# Generate one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Directory containing your GGUF LLM models on the host
LLAMA_MODELS_DIR=./models

# GGUF Model filename located inside LLAMA_MODELS_DIR
LLAMA_MODEL_FILE=qwen3-8b.gguf

# Number of GPU layers to offload (0 = CPU only, 33 / 99 = GPU offloading)
LLAMA_N_GPU_LAYERS=0

# Exposed Host Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
LLAMA_PORT=8080
