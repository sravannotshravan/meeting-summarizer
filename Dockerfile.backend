# ============================================================
# Stage 1: Build whisper.cpp CLI
# ============================================================
FROM python:3.11-slim AS whisper-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone https://github.com/ggerganov/whisper.cpp.git \
    && cd whisper.cpp \
    && cmake -B build \
    && cmake --build build --config Release -j $(nproc)

# Download default ggml-small model
WORKDIR /src/whisper.cpp/models
RUN sh ./download-ggml-model.sh small

# ============================================================
# Stage 2: Runtime Backend
# ============================================================
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy whisper binary and model from builder stage
COPY --from=whisper-builder /src/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-builder /src/whisper.cpp/models/ggml-small.bin /models/whisper/ggml-small.bin

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY ai/ ./ai/
COPY api/ ./api/
COPY backend/ ./backend/

# Create data directory
RUN mkdir -p /app/data/meetings

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    WHISPER_CLI_PATH=/usr/local/bin/whisper-cli \
    WHISPER_MODEL_PATH=/models/whisper/ggml-small.bin \
    LLAMA_URL=http://llama-server:8080/v1/chat/completions \
    LLAMA_MODEL=Qwen3-8B \
    PORT=8000

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
